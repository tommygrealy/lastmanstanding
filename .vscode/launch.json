{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: APP",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python-flask/app.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/python-flask/.venv/bin/python",
            "envFile": "${workspaceFolder}/.env",
        },
        {
            "name": "Python Debugger: setupNextRound",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/py/setupNextRound.py",
            "cwd": "${workspaceFolder}/py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/py/venv/bin/python",
            "envFile": "${workspaceFolder}/.env",
            "env": {"RUN_ENVIRON": "PROD"},
            "args": ["--round", "3"]
        },
        {
            "name": "Python Debugger: runPostRoundResultCheck (with args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/py/runPostRoundResultCheck.py",
            "cwd": "${workspaceFolder}/py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/py/venv/bin/python",
            "envFile": "${workspaceFolder}/.env",
            "args": ["--round", "3"],
            "env": {"RUN_ENVIRON": "PROD"}
        },
        {
            "name": "Python Debugger: placeDynamite.py (no args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/py/placeDynamite.py",
            "cwd": "${workspaceFolder}/py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/py/venv/bin/python",
            "envFile": "${workspaceFolder}/.env",
            "env": {"RUN_ENVIRON": "PROD"}
        }

    ]
}